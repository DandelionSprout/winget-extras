{
	"$schema": "https://anthelion.unownplain.dev/schema.json",
	"strategy": "page-match",
	"pageMatch": {
		"url": "https://translationcommons.org/gurung-dl/",
		"regex": "(?<url>https://translationcommons\\.org/wp-content/uploads/\\d{4}/\\d{2}/Khema_extended\\.zip)"
	},
	"version": { "source": "fontVersion" },
	"urls": [
		{
			"url": "{captures.url}",
			"nestedInstallerMatches": ["Khema_extended.ttf"]
		}
	],
	"state": { "source": "value", "value": "{captures.url}" }
}
